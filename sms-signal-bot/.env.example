# --- Webhook auth ---
# Shared secret that aspsms must include as ?token=... on every request.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_TOKEN=change-me-to-a-long-random-string

# --- signal-cli-rest-api service ---
# Base URL of the running signal-cli-rest-api service.
# On Railway use the private networking URL of that service, e.g.
#   http://signal-cli-rest-api.railway.internal:8080
SIGNAL_API_URL=http://signal-cli-rest-api.railway.internal:8080

# The Signal bot number, already registered, in E.164 format.
SIGNAL_NUMBER=+15551234567

# The signal-cli group id for the target group chat.
# Looks like:  group.aBcDeF0123...==
SIGNAL_GROUP_ID=group.CHANGE_ME

# --- Optional tuning ---
# Query-string parameter name that carries the message text (aspsms placeholder).
MESSAGE_PARAM=MessageData
# Query-string parameter name that carries the sender's number (leave blank to disable).
SENDER_PARAM=
# Seconds to wait on the Signal API before giving up.
REQUEST_TIMEOUT=10
